    window:AddHome({
        Changelog = {
            { Title = "SPV  |  Release", Version = "1.0", Tag = "New", Changes = {
                "Assist and Autoplay with separate presets",
                "No Wait planner, flow path and pattern recognition",
                "Humanize, curved paths and natural drift",
                "Full fine tuning, configs and themes",
            } },
        },
