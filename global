    local opts = cols[1]:AddSection({ Name = "Options", Icon = "settings" })
    opts:AddToggle({ Name = "No Wait", Desc = "Plans several notes ahead on a timeline", Flag = "sp_nowait", Default = true,
        Callback = function(on) nowait_on = on end })
    opts:AddToggle({ Name = "Flow path", Desc = "Stacked notes become one stop", Flag = "sp_flow", Default = true,
        Callback = function(on) flow_on = on end })
    opts:AddToggle({ Name = "Pattern recognition", Desc = "Detects spirals, slides, jumps, vibros, bursts", Flag = "sp_pattern", Default = true,
