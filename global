    ----------------------------------------------------------------
    -- Tune tab
    ----------------------------------------------------------------
    local tuneTab = window:AddTab({ Name = "Tune", Icon = "settings" })
    local tc = tuneTab:AddColumns(2)

    local function slider(sec, name, desc, flag, key, min, max, def, o)
        o = o or {}
        local div = o.Div or 1
        local e = sec:AddSlider({
            Name = name, Desc = desc, Min = min, Max = max, Step = o.Step or 1, Default = def,
            Suffix = o.Suffix, Flag = flag,
            Callback = function(v) T[key] = v / div end,
        })
        T[key] = def / div
        tuneEls[#tuneEls + 1] = { el = e, key = key, def = def, div = div }
    end

    local mv = tc[1]:AddSection({ Name = "Movement", Icon = "bolt" })
    slider(mv, "Speed", "Top cursor speed", "t_speed", "speed", 20, 250, 100, { Suffix = "%" })
    slider(mv, "Smoothness", "Higher = softer and slower to settle", "t_smooth", "smooth", 30, 300, 100, { Suffix = "%" })
    slider(mv, "Reaction range", "How early it starts moving toward a note", "t_range", "range", 40, 200, 100, { Suffix = "%" })
    slider(mv, "Acceleration", "How much it speeds up on busy sections", "t_accel", "accel", 0, 200, 100, { Suffix = "%" })
    slider(mv, "Mouse sensitivity", "Raise if the cursor undershoots, lower if it overshoots", "t_sens", "sens", 0.25, 4, 1, { Step = 0.05 })

    local fe = tc[1]:AddSection({ Name = "Feel", Icon = "bolt" })
    slider(fe, "Pull strength", "Base amount of help", "t_pull", "pull", 20, 160, 100, { Suffix = "%" })
    slider(fe, "Speed variation", "0 = steady speed, higher = more natural", "t_var", "var", 0, 200, 100, { Suffix = "%" })
    slider(fe, "Path curvature", "Strength of arcs when No Wait is off", "t_curve", "curve", 0, 200, 100, { Suffix = "%" })
    slider(fe, "Drift amount", "Strength of the natural sway", "t_drift", "drift", 0, 250, 100, { Suffix = "%" })

    local nw = tc[2]:AddSection({ Name = "No Wait", Icon = "refresh" })
    el.nw = nil
    slider(nw, "Look-ahead", "How far ahead it plans notes", "t_look", "look", 300, 2000, 900, { Suffix = " ms", Div = 1000 })
    slider(nw, "Arrival bias", "Positive = reach notes earlier, negative = later", "t_bias", "bias", -60, 80, 0, { Suffix = " ms", Div = 1000 })
    slider(nw, "Timing variation", "How much each stop's timing is off", "t_tvar", "tvar", 0, 300, 100, { Suffix = "%" })
    slider(nw, "Note speed (0 = auto)", "Set by hand only if auto detection fails", "t_nspeed", "nspeed", 0, 400, 0)

    local hu = tc[2]:AddSection({ Name = "Humanize", Icon = "user" })
    slider(hu, "Aim spread", "How far from the center it aims", "t_spread", "spread", 0, 250, 100, { Suffix = "%" })
    slider(hu, "Miss chance", "Scales how often it misses on purpose", "t_miss", "miss", 0, 300, 100, { Suffix = "%" })

    local ar = tc[2]:AddSection({ Name = "Assist response", Icon = "user" })
    slider(ar, "Help while still", "Help when your mouse isn't moving", "t_still", "still", 0, 150, 100, { Suffix = "%" })
    slider(ar, "Help toward note", "Help when you move toward a note", "t_toward", "toward", 0, 150, 100, { Suffix = "%" })
    slider(ar, "Help away from note", "Lower lets you override it", "t_away", "away", 0, 150, 100, { Suffix = "%" })
    ar:AddButton({ Name = "Reset fine tuning", Style = "Secondary", Confirm = true, Callback = function()
        for _, t in ipairs(tuneEls) do
            T[t.key] = t.def / t.div
            setEl(t.el, t.def)
        end
        say("Fine tuning reset", "Success")
    end })

    ----------------------------------------------------------------
    -- Island (shows while the window is hidden)
    ----------------------------------------------------------------
    ui:CreateIsland({ Window = window, Icon = "bolt", Text = "SPV" })
end

