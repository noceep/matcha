    local keys = cols[2]:AddSection({ Name = "Hotkeys", Icon = "settings" })
    keys:AddKeybind({ Name = "Switch Assist / Autoplay", Default = Enum.KeyCode.F, Flag = "kb_style",
        Callback = function()
            applyStyle(style == "assist" and "auto" or "assist")
            say("Mode: " .. (style == "auto" and "Autoplay" or "Assist"))
        end })
