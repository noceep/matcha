local el = {}  -- element handles, so hotkeys can update the menu

local function setEl(e, v)
    if e and e.Set then pcall(e.Set, e, v) end
end

local function refreshDesc()
    if el.desc and el.desc.SetValue then
        pcall(el.desc.SetValue, el.desc, DESC[style][level])
    end
end

local function applyStyle(s)
    style = s
    setEl(el.style, s == "auto" and "Autoplay" or "Assist")
    refreshDesc()
end

local function applyLevel(l)
    level = l
    setEl(el.level, l == 2 and "Strong / Instant" or "Light / Smooth")
    refreshDesc()
end

local tuneEls = {}

