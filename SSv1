local function mk(kind, rel, props)
    local o = Drawing.new(kind)
    for k, v in pairs(props) do o[k] = v end
    o.Position = origin + rel
    o.Visible = true
    ui[#ui + 1] = { o = o, rel = rel }
    return o
end

local function layout()
    for _, e in ipairs(ui) do
        e.o.Position = origin + e.rel
    end
end

