-- kill any previous instance first (so re-executing never stacks scripts)
if _G.SP_STOP then pcall(_G.SP_STOP) end

local alive = true

--========================================--
-- TUNING
--========================================--

local LOOP_DT    = 1/120
local SCAN_DT    = 1/40
local LIST_DT    = 0.25
local SWEEP_DT   = 0.5
local WIN_BACK   = 10
local WIN_FWD    = 60
local SWEEP_FAR  = 60
local MOVE_SCALE = 1.0

-- range     : 3D distance (studs) from cursor to note before the script acts
-- gain      : pull strength
-- max_speed : cap on assist speed (px/sec)
-- response  : velocity smoothing in seconds (higher = softer)
-- fade_in / fade_out : screen px under which assist is full / beyond which it is zero
-- acquire   : seconds to ramp the pull in after a new note is picked (kills the "snap")
-- offset_px : radius (px) of the random aim point around the note when off-center is ON
local MODES = {
    closet = {
        range = 16, gain = 8,  max_speed = 600,  response = 0.06,
        fade_in = 40, fade_out = 170, acquire = 0.05, offset_px = 8,
    },
    semi = {
        range = 18, gain = 14, max_speed = 1100, response = 0.035,
        fade_in = 30, fade_out = 230, acquire = 0.10, offset_px = 7,
    },
    blatant = {
        range = 20, gain = 28, max_speed = 9000, response = 0.02,
        fade_in = 1e9, fade_out = 1e9 + 1, acquire = 0, offset_px = 3,
    },
}

local ORDER  = {"closet", "semi", "blatant"}
local COLORS = {
    closet  = Color3.fromRGB(90, 200, 255),
    semi    = Color3.fromRGB(170, 120, 255),
    blatant = Color3.fromRGB(255, 90, 110),
}

-- keys (Windows virtual-key codes)
local KEY_CLOSET  = 0x46 -- F
local KEY_SEMI    = 0x47 -- G
local KEY_BLATANT = 0x48 -- H
local KEY_TOGGLE  = 0x4A -- J  assist on/off
local KEY_OFFSET  = 0x4B -- K  off-center on/off
local KEY_KILL    = 0x23 -- End  kill script

local currentMode = "semi"
local enabled     = true
local offset_on   = true

