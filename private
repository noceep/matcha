local function put(id, v)
    sv(id, v)
    local s = SYNCI[id]
    if s then T[s[2]] = v / s[3] return end
    if id == "sp_nowait" then nowait_on = v
    elseif id == "sp_flow" then flow_on = v
    elseif id == "sp_pattern" then pat_on = v
    elseif id == "sp_weave" then weave_on = v
    elseif id == "sp_failsafe" then failsafe_on = v
    elseif id == "sp_fovdraw" then P.draw = v
    elseif id == "sp_mode" then mode = v + 1
    end
end

-- preset script set values from outside
