--========================================--
-- MOTION LIB
--========================================--

local function smoothDamp2(tx, ty, vx, vy, smoothTime, maxSpeed, dt)
    smoothTime = math.max(0.0001, smoothTime)
    local omega = 2 / smoothTime
    local x = omega * dt
    local e = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x)

    local cx, cy = -tx, -ty
    local maxChange = maxSpeed * smoothTime
    local mag = math.sqrt(cx * cx + cy * cy)
    if mag > maxChange and mag > 0 then
        local f = maxChange / mag
        cx, cy = cx * f, cy * f
    end
    local tgx, tgy = -cx, -cy

    local tmpx = (vx + omega * cx) * dt
    local tmpy = (vy + omega * cy) * dt
    local nvx = (vx - omega * tmpx) * e
    local nvy = (vy - omega * tmpy) * e
    local ox = tgx + (cx + tmpx) * e
    local oy = tgy + (cy + tmpy) * e

    if tx * (ox - tx) + ty * (oy - ty) > 0 then
        ox, oy = tx, ty
        nvx, nvy = 0, 0
    end
    return ox, oy, nvx, nvy
end

local function bez(p0, p1, p2, t)
    local u = 1 - t
    return u * u * p0 + 2 * u * t * p1 + t * t * p2
end

local function arcControl(x0, y0, x2, y2, curve, frac)
    local dx, dy = x2 - x0, y2 - y0
    return x0 + dx * frac - dy * curve, y0 + dy * frac + dx * curve
end

local function rrange(a, b) return a + math.random() * (b - a) end

local function comp(v, a)
    if a == 1 then return v.X elseif a == 2 then return v.Y else return v.Z end
end

-- the two sideways (grid) coordinates of a world position
local function lat2(p)
    if DEPTH_AXIS == 1 then return p.Y, p.Z
    elseif DEPTH_AXIS == 2 then return p.X, p.Z
    else return p.X, p.Y end
end

local function plane_point(spos, cpos)
    return Vector3.new(
        DEPTH_AXIS == 1 and cpos.X or spos.X,
        DEPTH_AXIS == 2 and cpos.Y or spos.Y,
        DEPTH_AXIS == 3 and cpos.Z or spos.Z
    )
end

