-- MOVEMENT
--========================================--

local vel_x, vel_y = 0, 0
local acc_x, acc_y = 0, 0

local function trunc(v)
    if v >= 0 then return math.floor(v) else return math.ceil(v) end
end

local function send_move(dx, dy)
    acc_x = acc_x + dx
    acc_y = acc_y + dy
    local ix, iy = trunc(acc_x), trunc(acc_y)
    if ix ~= 0 or iy ~= 0 then
        acc_x = acc_x - ix
        acc_y = acc_y - iy
        mousemoverel(ix, iy)
    end
end

local last_tick = tick()

local last_tgt = nil
local acq_time = 0
local off_ux, off_uy = 0, 0
local n_off_px = 0
local arc_pending = false
local arc_p0x, arc_p0y = 0, 0
local arc_start = 1
local arc_sign = 1
local n_curve, n_frac, n_pow, n_lead, n_st = 0, 0.5, 2, 0.4, 1
local wob_f1, wob_f2, wob_p1, wob_p2 = 1, 2, 0, 0

local function roll_note(s)
    arc_sign = (math.random() < 0.5) and -1 or 1
    if math.random() < s.straight then
        n_curve = 0
    else
        n_curve = s.curve * T.curve * rrange(RAND.curve_min, RAND.curve_max)
    end
    n_frac = rrange(RAND.frac_min, RAND.frac_max)
    n_pow  = rrange(RAND.pow_min, RAND.pow_max)
    n_lead = math.clamp(s.lead * rrange(1 - RAND.lead_var, 1 + RAND.lead_var), 0, 1)
    n_st   = rrange(RAND.st_min, RAND.st_max)
    wob_f1, wob_f2 = rrange(2.5, 5), rrange(6, 10)
    wob_p1, wob_p2 = math.random() * 6.283, math.random() * 6.283
    local a = math.random() * math.pi * 2
    if math.random() < s.miss_chance * T.miss then
        off_ux, off_uy = math.cos(a), math.sin(a)
        n_off_px = s.miss_px
    else
        local r = math.sqrt(math.random())
        off_ux, off_uy = math.cos(a) * r, math.sin(a) * r
        n_off_px = s.offset_px * T.spread
    end
end

-- per-stop aim offset and timing error, rolled once when a stop is first planned
local ninfo = {}
local info_key = nil
local info_prune = 0

local function note_info(k, base)
    local key = math.floor(GL1[k] * 4 + 0.5) * 100003 + math.floor(GL2[k] * 4 + 0.5)
    local t = GFT[k]
    local info = ninfo[key]
    if info and math.abs(t - info.t) < 0.6 then return info end

    local a = math.random() * math.pi * 2
    local ux, uy, px
    if math.random() < base.miss_chance * T.miss then
        ux, uy, px = math.cos(a), math.sin(a), base.miss_px
    else
        local r = math.sqrt(math.random())
        ux, uy, px = math.cos(a) * r, math.sin(a) * r, base.offset_px * T.spread
    end
    info = { ux = ux, uy = uy, px = px, t = t,
             tn = (math.random() * 2 - 1) * base.tvar * T.tvar / 1000 }
    ninfo[key] = info

    local now = tick()
    if now - info_prune > 3 then
        info_prune = now
        for kk, v in pairs(ninfo) do
            if v.t < now - 2 then ninfo[kk] = nil end
        end
    end
    return info
end

-- planned path through the upcoming stops (index 0 = where the cursor was when the plan started)
local PT, PX, PY, PS = {}, {}, {}, {}
local anchor_x, anchor_y, anchor_t, anchor_vx, anchor_vy = 0, 0, 0, 0, 0
local last_fl1, last_fl2 = nil, nil

local function eval_path(tq, m, tens)
    if tq <= PT[0] then return PX[0], PY[0] end
    local k = 0
    while k < m - 1 and tq >= PT[k + 1] do k = k + 1 end
    local t0, t1 = PT[k], PT[k + 1]
    local h = t1 - t0
    local u = math.min(1, (tq - t0) / h)

    local m0x, m0y, m1x, m1y = 0, 0, 0, 0
    if tens > 0 then
        if k == 0 then
            m0x, m0y = anchor_vx * 0.6, anchor_vy * 0.6
        else
            local d = PT[k + 1] - PT[k - 1]
            local sc = tens * PS[k]
            m0x = (PX[k + 1] - PX[k - 1]) / d * sc
            m0y = (PY[k + 1] - PY[k - 1]) / d * sc
        end
        local sc1 = tens * PS[k + 1]
        if k + 1 < m then
            local d = PT[k + 2] - PT[k]
            m1x = (PX[k + 2] - PX[k]) / d * sc1
            m1y = (PY[k + 2] - PY[k]) / d * sc1
        else
            -- last planned stop: keep moving in the same direction instead of stopping
            m1x = (PX[k + 1] - PX[k]) / h * sc1
            m1y = (PY[k + 1] - PY[k]) / h * sc1
        end
    end

    local u2 = u * u
    local u3 = u2 * u
    local h00 = 2 * u3 - 3 * u2 + 1
    local h10 = u3 - 2 * u2 + u
    local h01 = -2 * u3 + 3 * u2
    local h11 = u3 - u2
    local x = h00 * PX[k] + h10 * h * m0x + h01 * PX[k + 1] + h11 * h * m1x
    local y = h00 * PY[k] + h10 * h * m0y + h01 * PY[k + 1] + h11 * h * m1y
    if tq > t1 then
        local e = math.min(tq - t1, 0.12)
        x, y = x + m1x * e * 0.5, y + m1y * e * 0.5
    end
    return x, y
end

local SW_F = { rrange(1.2, 2.4), rrange(2.8, 4.5), rrange(1.0, 2.2), rrange(2.5, 4.2) }
local SW_P = { math.random() * 6.283, math.random() * 6.283, math.random() * 6.283, math.random() * 6.283 }

local last_active = tick()
local idle_ox, idle_oy = 0, 0
local idle_t0 = nil
local idle_p, idle_f, idle_a, idle_b0x, idle_b0y

local function idle_wave(t)
    local x = idle_a[1] * (math.sin(math.pi * 2 * idle_f[1] * t + idle_p[1]) * 0.7
                         + math.sin(math.pi * 2 * idle_f[2] * t + idle_p[2]) * 0.3)
    local y = idle_a[2] * (math.sin(math.pi * 2 * idle_f[3] * t + idle_p[3]) * 0.7
                         + math.sin(math.pi * 2 * idle_f[4] * t + idle_p[4]) * 0.3)
    return x, y
end

local function new_idle(now)
    idle_t0 = now
    idle_p = { math.random() * 6.283, math.random() * 6.283, math.random() * 6.283, math.random() * 6.283 }
    idle_f = { rrange(0.12, 0.45), rrange(0.4, 0.9), rrange(0.10, 0.40), rrange(0.35, 0.85) }
    idle_a = { IDLE.ax * T.drift * rrange(0.5, 1), IDLE.ay * T.drift * rrange(0.5, 1) }
    idle_b0x, idle_b0y = idle_wave(0)
end

local function reset_idle()
    idle_ox, idle_oy = 0, 0
    idle_t0 = nil
end

local boost = 1
local prev_csx, prev_csy = nil, nil
local cvx, cvy = 0, 0
local asx, asy = 0, 0
local last_ax, last_ay = 0, 0
local user_vx, user_vy = 0, 0

local function step()
    local now = tick()
    local dt = math.clamp(now - last_tick, 0.001, 0.05)
    last_tick = now

    local base = MODES[LEVELS[style][level]]
    local auto = (style == "auto")
    if info_key ~= base then
        info_key = base
        ninfo = {}
    end

    local range      = base.range * T.range
    local accel      = 1 + (base.accel - 1) * T.accel
    local floor0     = math.clamp(base.floor * T.pull, 0, 1)
    local shape      = math.clamp(base.shape * T.var, 0, 1)
    local wobble_amt = base.wobble * T.var
    local sway_amt   = base.sway * T.drift
    local solo       = base.solo * T.still
    local with_user  = base.with_user * T.toward
    local against    = base.against * T.away
    local move_scale = T.sens

    local tx, ty = 0, 0
    local active = false
    local gapfrac = 0
    local pressure = 0
    local prof = 1

    local cposF, csx, csy = nil, nil, nil
    if cursor then
        local okp, p = pcall(getpos, cursor)
        if okp and p then
            cposF = p
            local sc, on = WorldToScreen(p)
            if on then csx, csy = sc.X, sc.Y end
        end
    end

    if csx and prev_csx then
        local a = 1 - math.exp(-dt / U_TAU)
        cvx = cvx + ((csx - prev_csx) / dt - cvx) * a
        cvy = cvy + ((csy - prev_csy) / dt - cvy) * a
        asx = asx + (last_ax - asx) * a
        asy = asy + (last_ay - asy) * a
        user_vx, user_vy = cvx - asx, cvy - asy
    else
        cvx, cvy, asx, asy, user_vx, user_vy = 0, 0, 0, 0, 0, 0
    end
    prev_csx, prev_csy = csx, csy

    local uraw = math.sqrt(user_vx * user_vx + user_vy * user_vy)
    local us = math.max(0, uraw - 0.15 * math.sqrt(asx * asx + asy * asy))
    local moving = auto and 0 or math.clamp((us - U_DEAD) / (U_FULL - U_DEAD), 0, 1)

    local swx, swy = 0, 0
    if drift_on and sway_amt > 0 then
        local f = sway_amt
        swx = f * (math.sin(now * SW_F[1] + SW_P[1]) * 0.65 + math.sin(now * SW_F[2] + SW_P[2]) * 0.35)
        swy = f * (math.sin(now * SW_F[3] + SW_P[3]) * 0.65 + math.sin(now * SW_F[4] + SW_P[4]) * 0.35)
    end

    local pull_floor = math.min(1, floor0 + (1 - floor0) * 0.5 * ((boost - 1) / math.max(accel - 1, 0.001)))

    -- No Wait / Flow: gather stops (merged stacks) with arrival times and aim points
    local spd = (T.nspeed > 0) and T.nspeed or speed
    local q = queue
    local m, kfirst = 0, nil
    if nowait_on and (auto or NW_IN_ASSIST) and spd and q.n > 0 and cposF and csx then
        if q ~= g_q or spd ~= g_spd or T.bias ~= g_bias or flow_on ~= g_flow or pat_on ~= g_pat then
            g_q, g_spd, g_bias, g_flow, g_pat = q, spd, T.bias, flow_on, pat_on
            g_n = build_stops(q, spd, T.bias, flow_on)
            if pat_on then
                pat_name, pat_step, pat_stack = classify(g_n)
            else
                pat_name, pat_step, pat_stack = "off", 0, 1
            end
        end

        local prev_at = -1e9
        for k = 1, g_n do
            local info = note_info(k, base)
            local at = (GFT[k] + GLT[k]) * 0.5 + info.tn
            if at < prev_at + NW_MINGAP then at = prev_at + NW_MINGAP end
            prev_at = at
            if math.max(at, GLT[k]) > now - NW_PASS then
                local sp, on = WorldToScreen(plane_point(GP[k], cposF))
                if on then
                    m = m + 1
                    if m == 1 then kfirst = k end
                    PT[m] = at
                    local ax, ay = sp.X, sp.Y
                    if human_on then
                        ax = ax + info.ux * info.px
                        ay = ay + info.uy * info.px
                    end
                    PX[m], PY[m] = ax, ay
                    -- longer stacks pass slower so the cursor stays on them
                    PS[m] = 1 / (1 + (GLT[k] - GFT[k]) * 10)
                end
            end
            if at > now + T.look then break end
        end

        -- vibro: swing less than the full distance, like a real shaking hand
        if pat_name == "vibro" and m >= 2 then
            local mx_, my_ = (PX[1] + PX[2]) * 0.5, (PY[1] + PY[2]) * 0.5
            for k = 1, m do
                PX[k] = mx_ + (PX[k] - mx_) * VIB_SHRINK
                PY[k] = my_ + (PY[k] - my_) * VIB_SHRINK
            end
        end
    else
        pat_name, pat_step, pat_stack = "none", 0, 1
        g_q = nil
    end

    local have = false
    local pathx, pathy, ex, ey, dist = 0, 0, 0, 0, 0
    local prog = 0
    local planned = false

    if m > 0 then
        planned = true
        have = true
        last_tgt = nil

        -- restart the plan only when the first stop actually changes (not when a stacked note is hit)
        local fl1, fl2 = GL1[kfirst], GL2[kfirst]
        local restart = true
        if last_fl1 then
            local d1, d2 = fl1 - last_fl1, fl2 - last_fl2
            restart = (d1 * d1 + d2 * d2) > REANCHOR_D * REANCHOR_D
        end
        if restart then
            last_fl1, last_fl2 = fl1, fl2
            anchor_x, anchor_y, anchor_t = csx, csy, now
            anchor_vx, anchor_vy = vel_x, vel_y
            roll_note(base)
        end

        local gap1 = math.max(0, (PT[1] - now) * spd)
        gapfrac = math.clamp(gap1 / base.reach, 0, 1)

        local st_eff = base.smooth_time * T.smooth * n_st / boost
        local lead = math.clamp(st_eff * 0.9, 0.01, 0.30)

        PT[0] = math.min(anchor_t, PT[1] - 0.05)
        PX[0], PY[0] = anchor_x, anchor_y
        local tens = curve_on and (PAT_TENS[pat_name] or NW_TENSION) or 0
        local px, py = eval_path(now + lead, m, tens)

        pathx, pathy = px + swx - csx, py + swy - csy
        ex, ey = PX[1] + swx - csx, PY[1] + swy - csy
        dist = math.sqrt(ex * ex + ey * ey)
    else
        last_fl1, last_fl2 = nil, nil
        local cur, tgt = cursor, target
        if cur and tgt and cposF and valid(tgt) then
            if tgt ~= last_tgt then
                last_tgt = tgt
                acq_time = now
                arc_pending = true
                roll_note(base)
            end

            local cpos = cposF
            local ok2, spos = pcall(getpos, tgt)
            if ok2 and spos then
                local dx, dy, dz = spos.X - cpos.X, spos.Y - cpos.Y, spos.Z - cpos.Z
                local d3 = math.sqrt(dx*dx + dy*dy + dz*dz)

                if d3 < range then
                    local aimw = AIM_AT_PLANE and plane_point(spos, cpos) or spos
                    local sp, on1 = WorldToScreen(aimw)
                    if on1 and csx then
                        have = true

                        local gap = math.abs(comp(spos, DEPTH_AXIS) - comp(cpos, DEPTH_AXIS))
                        gapfrac = math.clamp(gap / base.reach, 0, 1)

                        local aimx, aimy = sp.X + swx, sp.Y + swy
                        if human_on then
                            aimx = aimx + off_ux * n_off_px
                            aimy = aimy + off_uy * n_off_px
                        end

                        ex, ey = aimx - csx, aimy - csy
                        dist = math.sqrt(ex*ex + ey*ey)

                        if arc_pending then
                            arc_pending = false
                            arc_p0x, arc_p0y = csx, csy
                            arc_start = math.max(dist, 1)
                        end

                        prog = 1 - math.clamp(dist / arc_start, 0, 1)

                        pathx, pathy = ex, ey
                        if curve_on and n_curve > 0 and dist > 1 then
                            local u = 1 - (1 - math.min(1, prog + n_lead)) ^ n_pow
                            local c1x, c1y = arcControl(arc_p0x, arc_p0y, aimx, aimy, n_curve * arc_sign, n_frac)
                            pathx = bez(arc_p0x, c1x, aimx, u) - csx
                            pathy = bez(arc_p0y, c1y, aimy, u) - csy
                        end
                    end
                end
            end
        end
        if not have then last_tgt = nil end
    end

    if have then
        active = true

        local ufac = 1
        if not auto then
            local toward = 0
            if uraw > 1 and dist > 1 then
                toward = (user_vx * ex + user_vy * ey) / (uraw * dist)
            end
            local tfrac = (toward + 1) * 0.5
            local tgtf = against + (with_user - against) * tfrac
            ufac = solo + (tgtf - solo) * moving

            local blend = moving * 0.7
            pathx = pathx + (ex - pathx) * blend
            pathy = pathy + (ey - pathy) * blend
        end

        local crowdP = math.clamp((crowd_n - 1) / CROWD_REF, 0, 1)
        local lateP  = math.clamp((dist - LATE_START) / (LATE_FULL - LATE_START), 0, 1) * (1 - gapfrac)
        pressure = math.max(crowdP, lateP)

        local strength
        if planned then
            strength = math.clamp(T.pull, 0.2, 1)   -- the timeline already paces the motion
        else
            local near = 1 - gapfrac
            strength = pull_floor + (1 - pull_floor) * (near * near * (3 - 2 * near))
        end

        -- assist only: pull fades out with screen distance, so it can't play for you from afar
        if not auto then
            local fi = base.fade_in or 1e9
            local fo = base.fade_out or (fi + 1)
            if dist > fi then
                local t = math.clamp((dist - fi) / math.max(fo - fi, 1), 0, 1)
                strength = strength * (1 - t * t * (3 - 2 * t))
            end
        end

        local wob = 1
        if wobble_amt > 0 then
            wob = 1 + wobble_amt * (math.sin(now * wob_f1 + wob_p1) * 0.6 + math.sin(now * wob_f2 + wob_p2) * 0.4)
        end

        local ramp = 1
        local dz_scale = 0
        if planned then
            local pm = math.sqrt(pathx * pathx + pathy * pathy)
            if pm > base.deadzone then dz_scale = (pm - base.deadzone) / pm end
        else
            local bell = math.max(0, math.sin(math.pi * prog)) ^ 0.7
            prof = (1 - shape) + shape * (0.3 + 0.7 * bell)
            if base.acquire > 0 then
                local t = math.clamp((now - acq_time) / (base.acquire / boost), 0, 1)
                ramp = t * t * (3 - 2 * t)
            end
            if dist > base.deadzone then dz_scale = (dist - base.deadzone) / dist end
        end
        if drift_on then dz_scale = math.max(dz_scale, 0.35) end
        local k = strength * ramp * dz_scale * ufac * wob
        tx = pathx * k
        ty = pathy * k
    end

    local bt = 1 + (accel - 1) * pressure
    local tc = (bt > boost) and BOOST_ATTACK or BOOST_RELEASE
    boost = boost + (bt - boost) * (1 - math.exp(-dt / tc))
    if boost > accel then boost = accel end
    if boost < 1 then boost = 1 end

    local smooth_time = base.smooth_time * T.smooth * n_st * (planned and 1 or (1 + base.soft * gapfrac)) / boost
    local max_speed = base.max_speed * T.speed * boost * prof
    local idling = false
    if active then
        last_active = now
        reset_idle()
    elseif drift_on and (auto or moving < 0.25) then
        idling = true
        if not idle_t0 then new_idle(now) end
        local wx, wy = idle_wave(now - idle_t0)
        tx = (wx - idle_b0x) - idle_ox
        ty = (wy - idle_b0y) - idle_oy
        smooth_time, max_speed = IDLE.smooth_time, IDLE.max_speed
    else
        reset_idle()
    end

    local mx, my, nvx, nvy = smoothDamp2(tx, ty, vel_x, vel_y, smooth_time, max_speed, dt)
    vel_x, vel_y = nvx, nvy

    if idling then
        idle_ox = idle_ox + mx
        idle_oy = idle_oy + my
    end

    last_ax, last_ay = mx * move_scale / dt, my * move_scale / dt
    send_move(mx * move_scale, my * move_scale)
end

task.spawn(function()
    local last_err = nil
    while alive do
        if enabled and isrbxactive() then
            local ok, err = pcall(step)
            if not ok and err ~= last_err then
                last_err = err
                warn("[SP] error: " .. tostring(err))
            end
        else
            vel_x, vel_y = 0, 0
            boost = 1
            prev_csx, prev_csy = nil, nil
            last_ax, last_ay = 0, 0
            last_tick = tick()
            last_active = tick()
            last_fl1, last_fl2 = nil, nil
            reset_idle()
        end
        task.wait(LOOP_DT)
    end
end)

